function Turn_All_Colors_Off\
  $cnt1 := 0\
  while ($cnt1<=127)\
    set_key_color($cnt1,$KEY_COLOR_INACTIVE)\
    inc($cnt1)\
  end while\
end function\
\
\
\
function Load_Preset\
  $cnt2 := 0\
  call Turn_All_Colors_Off\
  $cnt1 := $Start_Pres\
  while ($cnt1<=$Stop_Pres)\
    $Got_Key := %User_Presets[$cnt1]\
    $LastKey := %Previous_Key[$cnt2]\
    %New_Key[$cnt2] := %User_Presets[$cnt1]\
    %Previous_Key[$cnt2] := %New_Key[$cnt2]\
    if ($Got_Key=-1)\
      set_control_par(%Note_Nm_ID[$cnt2],$CONTROL_PAR_VALUE,0)\
      set_control_par(%Note_Nm_ID[$cnt2],$CONTROL_PAR_HIDE,$HIDE_WHOLE_CONTROL)\
    else\
      set_control_par(%Note_Nm_ID[$cnt2],$CONTROL_PAR_VALUE,%New_Key[$cnt2])\
      set_key_color(%New_Key[$cnt2],$KEY_COLOR_BLUE)\
      set_control_par(%Note_Nm_ID[$cnt2],$CONTROL_PAR_HIDE,$HIDE_PART_BG)\
    end if\
    pgs_set_key_val(IDX_NUM,0,$cnt2)\
    pgs_set_key_val(PLAY_KEY,0,%New_Key[$cnt2])\
    wait(500)\
    inc($cnt2)\
    inc($cnt1)\
  end while\
end function\
\
function Test_for_Key\
  inc($Start_Pres)\
  $Got_Key := -1\
  $cnt1 := 0\
  while ($cnt1<=127)\
    if (%KEY_DOWN[$cnt1]>0)\
      $Got_Key := $cnt1\
      $cnt1 := 128\
      exit\
    end if\
    inc($cnt1)\
  end while\
end function\
\
function Send_Note\
  if ($Got_Key>-1)\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_VALUE,$Got_Key)\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_HIDE,$HIDE_PART_BG)\
    set_key_color($Got_Key,$KEY_COLOR_BLUE)\
    %Previous_Key[$mx] := $Got_Key\
    %New_Key[$mx] := $Got_Key\
  else\
    %New_Key[$mx] := $Got_Key\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_VALUE,-1)\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_HIDE,$HIDE_WHOLE_CONTROL)\
  end if\
  pgs_set_key_val(IDX_NUM,0,$mx)\
  pgs_set_key_val(PLAY_KEY,0,$Got_Key)\
end function\
\
function Reset_Colors\
  $cnt1 := 0\
  while ($cnt1<=$Last_Kit_Pc)\
    if (%New_Key[$cnt1] # -1)\
      set_key_color(%New_Key[$cnt1],$KEY_COLOR_BLUE)\
    end if\
    inc($cnt1)\
  end while\
end function\
\
function Save_Preset\
  $cnt2 := 0\
  $cnt1 := $Start_Pres\
  while ($cnt1<=$Stop_Pres)\
    %User_Presets[$cnt1] := %New_Key[$cnt2]\
    inc($cnt2)\
    inc($cnt1)\
  end while\
end function\
\
function Set_Colors\
  set_key_color($LastKey,$KEY_COLOR_INACTIVE)\
  set_key_color($Got_Key,$KEY_COLOR_BLUE)\
end function\
\
function Chng_Key_Nmb\
  if ($Got_Key>-1)\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_VALUE,$Got_Key)\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_HIDE,$HIDE_PART_BG)\
    $LastKey := %Previous_Key[$mx]\
    if (%Previous_Key[$mx]>-1)\
      call Set_Colors\
    else\
      set_key_color($Got_Key,$KEY_COLOR_BLUE)\
    end if\
    %Previous_Key[$mx] := $Got_Key\
    %New_Key[$mx] := $Got_Key\
  else\
    %New_Key[$mx] := $Got_Key\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_VALUE,0)\
    set_control_par(%Note_Nm_ID[$mx],$CONTROL_PAR_HIDE,$HIDE_WHOLE_CONTROL)\
    if ($Got_Key=-1)\
      set_key_color(%Previous_Key[$mx],$KEY_COLOR_INACTIVE)\
    end if\
    %Previous_Key[$mx] := %New_Key[$mx]\
  end if\
  pgs_set_key_val(IDX_NUM,0,$mx)\
  pgs_set_key_val(PLAY_KEY,0,$Got_Key)\
end function\
\
function Warning\
  set_control_par_str($Warn_ID,$CONTROL_PAR_TEXT,!WarnTx[1])\
  $Warn_Swch := 0\
  $cnt2 := 0\
  $cnt3 := 0\
  while ($cnt3<=5)\
    $cnt2 := 0\
    set_control_par_str($Warn_ID,$CONTROL_PAR_TEXT,!WarnTx[1])\
    wait(300000)\
    set_control_par_str($Warn_ID,$CONTROL_PAR_TEXT,!WarnTx[0])\
    wait(200000)\
    inc($cnt3)\
  end while\
  set_control_par_str($Warn_ID,$CONTROL_PAR_TEXT,!WarnTx[0])\
end function\
\
on pgs_changed\
  if (pgs_key_exists(EVNT_NOTE))\
    $EvntNote := pgs_get_key_val(EVNT_NOTE,0)\
  end if\
  if ($FirstTime=1)\
    $cnt1 := 0\
    while ($cnt1<=$Last_Kit_Pc)\
      pgs_set_key_val(IDX_NUM,0,$cnt1)\
      pgs_set_key_val(PLAY_KEY,0,%New_Key[$cnt1])\
      wait(1000)\
      inc($cnt1)\
    end while\
    $FirstTime := 0\
  end if\
end on\
\
on note\
  wait(1000)\
  $cnt1 := search(%New_Key,$EvntNote)\
  if ($In_Use=-1)\
    if ($cnt1 # -1)\
      wait(80000)\
      $EvntNote := -1\
    end if\
  else\
  end if\
end on\
\
on ui_control($Presets_Menu)\
  select ($Presets_Menu)\
    case 3\
      $Presets_Menu := 0\
      $Start_Pres := 0\
      $Stop_Pres := $Last_Kit_Pc\
      call Load_Preset\
    case 4\
      $Presets_Menu := 0\
      $Start_Pres := $Last_Kit_Pc+1\
      $Stop_Pres := $Start_Pres+$Last_Kit_Pc\
      call Load_Preset\
    case 12\
      $Presets_Menu := 0\
      $Start_Pres := 0\
      $Stop_Pres := $Last_Kit_Pc\
      call Save_Preset\
    case 13\
      $Presets_Menu := 0\
