\{ *** VIEW SWITCHING FUNCTION *** \}\
function switch_bg\
  \{ Hide all FX backgrounds \}\
  hide_part($bg_fx1, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx2, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx3, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx4, $HIDE_WHOLE_CONTROL)\
