\{ *** FUNCTIONS *** \}\
\
function update_solo_states()\
  $solo_count := 0\
  \
  \{ Count how many channels are soloed \}\
  $solo_count := $solo_count + %solo_states[0] \{ kickin \}\
  $solo_count := $solo_count + %solo_states[1] \{ kickout \}\
  $solo_count := $solo_count + %solo_states[2] \{ snrtop \}\
  $solo_count := $solo_count + %solo_states[3] \{ snrbtm \}\
  $solo_count := $solo_count + %solo_states[4] \{ tom1 \}\
  $solo_count := $solo_count + %solo_states[5] \{ tom2 \}\
  $solo_count := $solo_count + %solo_states[6] \{ hihat \}\
  $solo_count := $solo_count + %solo_states[7] \{ oh \}\
  $solo_count := $solo_count + %solo_states[8] \{ rooma \}\
  $solo_count := $solo_count + %solo_states[9] \{ roomb \}\
  \
  \{ Apply solo/mute logic to all channels \}\
  if ($solo_count = 0)\
    \{ No solo active - unmute all channels \}\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 0)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 1)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 2)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 3)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 4)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 5)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 6)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 7)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 8)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 9)\
  else\
    \{ Solo active - mute all channels first \}\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 0)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 1)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 2)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 3)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 4)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 5)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 6)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 7)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 8)\
    set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 0, -1, 0, $NI_BUS_OFFSET + 9)\
    \
    \{ Then unmute only the soloed channels \}\
    if (%solo_states[0] = 1) \{ kickin \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 0)\
    end if\
    if (%solo_states[1] = 1) \{ kickout \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 1)\
    end if\
    if (%solo_states[2] = 1) \{ snrtop \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 2)\
    end if\
    if (%solo_states[3] = 1) \{ snrbtm \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 3)\
    end if\
    if (%solo_states[4] = 1) \{ tom1 \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 4)\
    end if\
    if (%solo_states[5] = 1) \{ tom2 \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 5)\
    end if\
    if (%solo_states[6] = 1) \{ hihat \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 6)\
    end if\
    if (%solo_states[7] = 1) \{ oh \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 7)\
    end if\
    if (%solo_states[8] = 1) \{ rooma \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 8)\
    end if\
    if (%solo_states[9] = 1) \{ roomb \}\
      set_engine_par($ENGINE_PAR_EFFECT_BYPASS, 1, -1, 0, $NI_BUS_OFFSET + 9)\
    end if\
  end if\
end function\
