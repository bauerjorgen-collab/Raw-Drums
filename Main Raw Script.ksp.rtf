  declare %VMID[20] \{ 10 buses x 2 meters (left/right) \}\
  declare $mx\
  declare $vx\
  \
  \{ ===== ADJUST THESE VALUES TO CHANGE SIZE AND POSITION ===== \}\
  \
  \{ Position settings \}\
  declare $START_X := 134    \{ Starting X position (pixels from left) \}\
  declare $SPACING_X := 80  \{ Spacing between each bus meter pair \}\
  declare $START_Y := 324    \{ Starting Y position (pixels from top) \}\
  \
  \{ Size settings \}\
  declare $METER_HEIGHT := 198  \{ Height of each meter \}\
  declare $METER_WIDTH := 11     \{ Width of each meter \}\
  \
  \{ =========================================================== \}\
  \
  \{ Create volume meters for buses 1-10 with unique variable names \}\
  declare ui_level_meter $Bus1_vml\
  declare ui_level_meter $Bus1_vmr\
