  hide_part($bg_fx6, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx7, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx8, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx9, $HIDE_WHOLE_CONTROL)\
  hide_part($bg_fx10, $HIDE_WHOLE_CONTROL)\
  \
  \{ Show appropriate background \}\
  if ($fx1_active = 1)\
    hide_part($bg_fx1, $HIDE_PART_NOTHING)\
  else \
    if ($fx2_active = 1)\
      hide_part($bg_fx2, $HIDE_PART_NOTHING)\
    else \
      if ($fx3_active = 1)\
        hide_part($bg_fx3, $HIDE_PART_NOTHING)\
      else \
        if ($fx4_active = 1)\
          hide_part($bg_fx4, $HIDE_PART_NOTHING)\
        else \
          if ($fx5_active = 1)\
            hide_part($bg_fx5, $HIDE_PART_NOTHING)\
          else \
            if ($fx6_active = 1)\
              hide_part($bg_fx6, $HIDE_PART_NOTHING)\
            else \
              if ($fx7_active = 1)\
                hide_part($bg_fx7, $HIDE_PART_NOTHING)\
              else \
                if ($fx8_active = 1)\
                  hide_part($bg_fx8, $HIDE_PART_NOTHING)\
                else \
                  if ($fx9_active = 1)\
                    hide_part($bg_fx9, $HIDE_PART_NOTHING)\
                  else \
                    if ($fx10_active = 1)\
                      hide_part($bg_fx10, $HIDE_PART_NOTHING)\
                    end if\
                  end if\
                end if\
              end if\
            end if\
          end if\
        end if\
      end if\
    end if\
  end if\
end function\
