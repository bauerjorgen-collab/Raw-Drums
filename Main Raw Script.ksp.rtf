  \
  \{ Position and configure volume meters \}\
  $mx := 0\
  while ($mx < 10)\
    $vx := 0\
    while ($vx <= 1)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_POS_X, $START_X + ($mx * $SPACING_X))\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_HEIGHT, $METER_HEIGHT)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_WIDTH, $METER_WIDTH)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_POS_Y, $START_Y)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_VERTICAL, 1)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_OFF_COLOR, 1184526)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_BG_COLOR, 1184526)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_ON_COLOR, 9733230)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_PEAK_COLOR, 16777215)\
      set_control_par(%VMID[2*$mx+$vx], $CONTROL_PAR_OVERLOAD_COLOR, 16711680)\
      \
      \{ Attach to bus \}\
      attach_level_meter(%VMID[2*$mx+$vx], -1, -1, $vx, $mx)\
      \
      inc($vx)\
    end while\
    inc($mx)\
  end while\
