{ - - - Humanize Callbacks - - - }

on note
  { Calculate all humanization values based on the single knob }
  $timing_amount := $Humanize
  $velocity_amount := $Humanize
  $volume_amount := $Humanize
  
  { Velocity humanization }
  $new_vel := $EVENT_VELOCITY + (random (-15,15) * $velocity_amount / 150)
  if (in_range ($new_vel,0,127))
    $new_vel := $new_vel
  else
    if ($new_vel > 127)
      $new_vel := 127
    end if
    if ($new_vel < 1)
      $new_vel := 1
    end if
  end if

  if ($timing_amount > 0)
    ignore_event ($EVENT_ID)
    $new_time := random (0,$timing_amount * 300)  { 10% timing range }
    wait($new_time+1)
    $new_event := play_note ($EVENT_NOTE,$new_vel,0,-1)
    change_vol ($new_event, (random (-7,7) * $volume_amount) + get_event_par($EVENT_ID,$EVENT_PAR_VOLUME), 1)  { 20% volume range }

  else
    change_velo($EVENT_ID,$new_vel)
    change_vol ($EVENT_ID, random (-7,7) * $volume_amount, 1)  { 20% volume range }

  end if
  




end on



