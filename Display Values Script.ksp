{ *** ADD DISPLAY LABELS FOR FX1 *** }
    
    { EQ Display Labels }
    declare ui_label $hf_gain_display1(3, 1)
    move_control_px($hf_gain_display1, 700, 145)
    hide_part($hf_gain_display1, $HIDE_PART_BG)
    set_text($hf_gain_display1, "0.0 dB")

    declare ui_label $hf_freq_display1(3, 1)
